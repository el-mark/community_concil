<h1>Problemas reportados</h1>

<% if @issues.empty? %>
  <div class="card">
    <p>Todavía no se ha reportado ningún problema.</p>
    <p><%= link_to "Reporta el primero", new_issue_path %>.</p>
  </div>
<% else %>
  <% @issues.each do |issue| %>
    <div class="card issue">
      <div class="issue-header">
        <h2><%= issue.title %></h2>
        <span class="badge badge-<%= issue.frequency %>"><%= issue.frequency_label %></span>
      </div>
      <p class="muted">
        <%= issue.address %> ·
        reportado por <%= issue.user.email %> ·
        hace <%= time_ago_in_words(issue.created_at) %>
      </p>
      <p><%= simple_format(issue.description) %></p>
    </div>
  <% end %>
<% end %>
