<h1>Reportar un problema</h1>

<%= form_with model: @issue, class: "card form" do |f| %>
  <% if @issue.errors.any? %>
    <div class="errors">
      <ul>
        <% @issue.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :frequency %>
    <%= f.select :frequency, Issue.frequency_options, prompt: "¿Con qué frecuencia ocurre?" %>
  </div>

  <div class="field">
    <%= f.label :address %>
    <%= f.text_field :address, required: true, placeholder: "Av. Arequipa 1234, Lima" %>
  </div>

  <div class="field">
    <%= f.label :title, "Título del problema" %>
    <%= f.text_field :title, required: true, maxlength: 150, placeholder: "Poste de luz malogrado" %>
  </div>

  <div class="field">
    <%= f.label :description, "Descripción del problema" %>
    <%= f.text_area :description, required: true, rows: 6, placeholder: "Describe el problema en detalle…" %>
  </div>

  <%= f.submit "Reportar problema" %>
<% end %>
