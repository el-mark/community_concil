<h1>Report an issue</h1>

<%= form_with model: @issue, class: "card form" do |f| %>
  <% if @issue.errors.any? %>
    <div class="errors">
      <ul>
        <% @issue.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :frequency %>
    <%= f.select :frequency, Issue.frequencies.keys.map { |k| [k.capitalize, k] }, prompt: "How often does this happen?" %>
  </div>

  <div class="field">
    <%= f.label :address %>
    <%= f.text_field :address, required: true, placeholder: "123 Main St" %>
  </div>

  <div class="field">
    <%= f.label :title, "Title of the issue" %>
    <%= f.text_field :title, required: true, maxlength: 150, placeholder: "Broken streetlight" %>
  </div>

  <div class="field">
    <%= f.label :description, "Description of the issue" %>
    <%= f.text_area :description, required: true, rows: 6, placeholder: "Describe the issue in detail…" %>
  </div>

  <%= f.submit "Report issue" %>
<% end %>
