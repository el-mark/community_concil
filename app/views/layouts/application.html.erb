<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Junta Vecinal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to "Junta Vecinal", root_path, class: "brand" %>
        <nav>
          <%= link_to "Reportar un problema", new_issue_path %>
          <%= link_to "Todos los problemas", issues_path %>
          <% if current_user %>
            <span class="user-email"><%= current_user.email %></span>
            <%= button_to "Cerrar sesión", logout_path, method: :delete, class: "link-button" %>
          <% else %>
            <%= link_to "Registrarse", signup_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>

      <%= yield %>
    </main>
  </body>
</html>
