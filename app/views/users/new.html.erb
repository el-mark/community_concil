<h1>Regístrate</h1>
<p>Ingresa tu correo electrónico y te enviaremos un enlace de verificación. Una vez verificado, podrás reportar incidencias.</p>

<%= form_with model: @user, url: signup_path, class: "card form" do |f| %>
  <% if @user.errors.any? %>
    <div class="errors">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :email %>
    <%= f.email_field :email, required: true, autofocus: true, placeholder: "tucorreo@ejemplo.com" %>
  </div>

  <%= f.submit "Enviar correo de verificación" %>
<% end %>
